<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>nuel</RootNamespace>
		<AssemblyName>CaptchaSqlite</AssemblyName>
		<Version>1.0.0</Version>
		<Company>nuel</Company>
		<Product>Captcha SQLite</Product>
		<Authors>Ako Mahmoodi</Authors>
		<RepositoryUrl>https://github.com/pellk/Captcha</RepositoryUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>A .NET captcha library with file-backed SQLite storage and SixLabors ImageSharp rendering.</Description>
		<PackageTags>captcha;sqlite;base64</PackageTags>
		<PackageId>nuel_CaptchaSqlite</PackageId>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
		<PackageReference Include="SixLabors.Fonts" Version="3.2.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
	</ItemGroup>
	<ItemGroup>
		<None Include="LICENSE">
			<Pack>True</Pack>
			<PackagePath />
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath />
		</None>
	</ItemGroup>
</Project>
